{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "dragDropEnabled": false,
        "title": "Mailboat",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 520,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer.nsh"
      }
    }
  }
}
