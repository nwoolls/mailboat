{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mailboat",
  "version": "../package.json",
  "identifier": "com.nwoolls.mailboat",
  "mainBinaryName": "mailboat",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "dragDropEnabled": false,
        "title": "Mailboat",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self' email-link: http://email-link.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; frame-src 'self' email-link: http://email-link.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxN0MxOEUxQUNEMTkxN0YKUldSL2tkR3M0Umg4QWN0RjgxTE1zQTlEVmNjNlBCK21NSDJYNGNFbW1TL0VHTC9zVnE0VGNWb1IK",
      "endpoints": [
        "https://getmailboat.app/updates/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
