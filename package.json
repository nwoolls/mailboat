{
  "name": "desktop",
  "version": "0.2.1",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "playground": "vite --port 1437 --strictPort --open /playground/",
    "tauri": "tauri",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "clean-start": "tauri dev -- -- --clean-start",
    "demo": "tauri dev -- -- --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run check:web && bun run check:rust && bun run test:browser",
    "check:quick": "scripts/check-quick.sh",
    "check:brand": "bun scripts/check-brand.ts",
    "check:website": "bun scripts/check-website.ts",
    "check:codex": "bun scripts/check-codex-review.ts",
    "check:privacy": "bun scripts/check-privacy.ts",
    "check:web": "bun run fmt:check && bun run lint && bun run typecheck && bun run check:brand && bun run check:website && bun run check:privacy && bun run check:codex && bun run test",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "cmdk": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3"
}
