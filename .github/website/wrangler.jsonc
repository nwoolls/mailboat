// How the website is published to Cloudflare (read by .github/workflows/website.yml).
// The Worker's name is not here: the workflow passes it from a GitHub variable.
// It lives outside website/ so it is never served as a page.
{
  "compatibility_date": "2026-11-01",
  // The site is reached through its own domain only (a route set in the Cloudflare
  // dashboard), so the public *.workers.dev address and preview URLs stay off.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../website",
    // Unknown addresses get website/404.html, with its real 404 status.
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": false },
}
