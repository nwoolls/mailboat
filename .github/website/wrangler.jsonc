// How the website is published to Cloudflare (read by .github/workflows/website.yml).
// The Worker's name is not here: the workflow passes it from a GitHub variable.
// It lives outside website/ so it is never served as a page.
{
  "compatibility_date": "2026-11-01",
  // The site is reached through its own domain only (a route set in the Cloudflare
  // dashboard), so the public *.workers.dev address and preview URLs stay off.
  "workers_dev": false,
  "preview_urls": false,
  // The site's one bit of code: it serves the clips (/video/*.mp4) with byte
  // ranges, which Safari needs to play a video and static assets don't give
  // (worker.js). Every other address, the clips' stills included, is a plain
  // file and never reaches it.
  "main": "worker.js",
  "assets": {
    "directory": "../../website",
    "binding": "ASSETS",
    "run_worker_first": ["/video/*.mp4"],
    // Unknown addresses get website/404.html, with its real 404 status.
    "not_found_handling": "404-page",
  },
  // A deploy keeps any variable set in the Cloudflare dashboard (by default it
  // deletes them). There are none today; this keeps a later one safe.
  "keep_vars": true,
  "observability": { "enabled": false },
}
