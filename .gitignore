# Makes check:codex fail (not just warn) on the owner's machine
.codex-review-enforce

# Secrets: never commit OAuth client files or keys
.env
.env.*
*.key
*.pem
*.p12
client_secret*.json
google-oauth-client*.json

node_modules/
dist/
target/
src-tauri/gen/schemas/
coverage/
# Rendered clips (video/): published deliberately, never by accident
video/out/
# macOS's own wallpaper, made locally by video/render.sh, never committed
video/public/sonoma.png
video/public/sonoma-blur.png
# wrangler dev's working files (the website's Worker, tried locally)
.wrangler/
*.tsbuildinfo
*.log
.vite/

*.dmg
*.app/
*.msi
*.exe

.idea/
.vscode/settings.json
.DS_Store

# Built by src-tauri/build.rs (the Apple Intelligence helper)
src-tauri/binaries/

# Playwright (tests/browser)
test-results/
test-results-*/
playwright-report/
